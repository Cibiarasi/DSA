import java.util.*;
public class Duplicate {
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        HashSet<Integer> set=new HashSet<>();
        for(int i=0;i<n;i++){
            int value=sc.nextInt();
            set.add(value);
        }
        if(n==set.size()){
            System.out.print("true");
        }
        else{
            System.out.print("false");
        }
    }
    
}
