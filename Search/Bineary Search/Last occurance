import java.util.*;
public class Last_occurance{
    public static void main(String[] args){
        int arr[]=new int[]{1,2,2,2,3,4,5,6,6};
        int left=0;
        int right=arr.length-1;
        int target=6;
        int ans=-1;
        while(left<=right){
            int mid=left+(right-left)/2;
            if(arr[mid]==target){
                ans=mid;
                left=mid+1;
            }
            else if(arr[mid]<target){
                left=mid+1;
            }
            else{
                right=mid-1;
            }
        }
        System.out.print("last occurance: "+ans);
    }
}
