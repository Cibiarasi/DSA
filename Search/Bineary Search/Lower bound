import java.util.*;
public class Lower_Bound {
    public static void main(String[]args){
        int arr[]=new int[]{1,2,3,4,5};
        int left=0;
        int right=arr.length-1;
        int target=2;
        int ans=-1;
        while(left<=right){
            int mid=left+(right-1)/2;
            if(arr[mid]>=target){
                ans=mid;
                right=mid-1;
            }
            else if(arr[mid]<target){
                left=mid+1;
            }
        }
        System.out.println("lower bound: "+ans);
    }
    
}
