import java.util.*;
public class Count_occurance {
    public static void main(String[] args){
        int arr[]=new int[]{1,2,2,2,2,3,4,5};
        int left=0;
        int right=arr.length-1;
        int target=1;
        int firstans=-1;
        while(left<=right){
            int mid=left+(right-left)/2;
            if(arr[mid]==target){ 
            firstans=mid;
            right=mid-1;
        }
        else if(arr[mid]<target){
            left=mid+1;
        }
        else{
            right=mid-1;
        }
    }
        
        left=0;
        right=arr.length-1;
        int lastans=-1;
        while(left<=right){
            int mid=left+(right-left)/2;
            if(arr[mid]==target){
                lastans=mid;
            left=mid+1;

            }
            
        
        else if(arr[mid]<target){
            left=mid+1;
        }
        else{
            right=mid-1;
        }
    }
        if(firstans==-1){
            System.out.println("occrance count:0");
        }
        else{
            int count=lastans-firstans+1;
            System.out.println("occrance count: "+count);
        }
        

    }
    
}
